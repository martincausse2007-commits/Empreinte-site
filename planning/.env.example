# =============================================================================
# Quinzo — variables d'environnement
# Copiez ce fichier en « .env.local » (sur votre ordinateur) et remplissez-le.
# Sur Vercel : Project → Settings → Environment Variables (mêmes noms).
# Ne mettez JAMAIS ces valeurs dans le code ni dans un message.
# =============================================================================

# Adresse de votre projet Supabase.
# Supabase → votre projet → Project Settings → Data API → « Project URL ».
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique du projet (« publishable key », ou « anon public » sur les anciens projets).
# Supabase → Project Settings → API Keys. Elle peut être visible dans le navigateur :
# la sécurité est assurée par les règles RLS de la base (voir supabase/migrations).
# N'utilisez JAMAIS ici la clé « secret » / « service_role ».
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique du site (sert aux liens dans les e-mails : confirmation, mot de passe…).
# En local : http://localhost:3000 — en ligne : https://votre-domaine.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Uniquement pour les tests de sécurité de la base, en local (npm run test:db).
# TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
