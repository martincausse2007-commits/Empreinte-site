# =============================================================================
# Quinzo — variables d'environnement
# Copiez ce fichier en « .env.local » (sur votre ordinateur) et remplissez-le.
# Sur Vercel : Project → Settings → Environment Variables (mêmes noms).
# Ne mettez JAMAIS ces valeurs dans le code ni dans un message.
# =============================================================================

# Adresse de votre projet Supabase.
# Supabase → votre projet → Project Settings → Data API → « Project URL ».
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique du projet (« publishable key », ou « anon public » sur les anciens projets).
# Supabase → Project Settings → API Keys. Elle peut être visible dans le navigateur :
# la sécurité est assurée par les règles RLS de la base (voir supabase/migrations).
# N'utilisez JAMAIS ici la clé « secret » / « service_role ».
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique du site (sert aux liens dans les e-mails : confirmation, mot de passe…).
# En local : http://localhost:3000 — en ligne : https://votre-domaine.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse qui reçoit les avis du bouton « Donner mon avis » (facultatif).
# Elle sera visible dans le site : utilisez une adresse dédiée, pas votre adresse perso.
NEXT_PUBLIC_FEEDBACK_EMAIL=

# ---- Notifications gratuites (phase 2) ----------------------------------------
# Notifications du téléphone (web push). Créez la paire de clés UNE fois sur votre
# ordinateur avec :  npx web-push generate-vapid-keys
# La clé publique peut être visible ; la clé privée reste SECRÈTE (Vercel uniquement).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Une adresse de contact (exigée par les navigateurs), au format mailto:
VAPID_SUBJECT=mailto:contact@votre-domaine.fr

# E-mails de notification (facultatif) : Brevo, offre gratuite (300 e-mails / jour).
# Brevo → SMTP & API → API Keys. Clé SECRÈTE : seulement sur Vercel.
BREVO_API_KEY=
# Adresse d'expéditeur validée dans Brevo (ex. planning@votre-domaine.fr)
NOTIFY_FROM_EMAIL=

# Uniquement pour les tests de sécurité de la base, en local (npm run test:db).
# TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
